# Copy to .env locally, fill in your PostgreSQL URL, then export it in your shell.
# The application does not automatically load .env files.
DATABASE_URL=
APP_ENV=development
# In Railway: APP_ENV=production; cookie Secure is enforced automatically.
# Optional additional same-origin URL (e.g. your Railway HTTPS domain).
APP_ORIGIN=
# Local Vite proxy origins; ignored in production unless explicitly configured.
ALLOWED_ORIGINS=
PORT=8000
